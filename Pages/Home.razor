@page "/Portafolio/"

<PageTitle>Jorge | Ingeniero Informatico</PageTitle>

<section class="hero-section">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudGrid Spacing="6" AlignItems="Center">
            <MudItem xs="12" md="6">
                <MudStack Spacing="3" Class="hero-copy">
                    <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Class="status-pill">
                        Disponible para trabajar
                    </MudChip>

                    <MudText Typo="Typo.h1" Class="hero-title">
                        Hola, soy <span class="text-highlight">Jorge</span>
                    </MudText>

                    <MudText Typo="Typo.h5" Class="hero-subtitle">
                        Ingeniero informatico y desarrollador full-stack
                    </MudText>

                    <MudText Typo="Typo.body1" Class="hero-lead">
                        Graduado de la <strong>Universidad de Ciencias Informaticas (UCI)</strong>
                        en La Habana. Construyo productos web y moviles con .NET, Node.js,
                        Flutter y bases de datos.
                    </MudText>

                    <MudStack Row="true" Spacing="2" Class="hero-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Href="/Portafolio//proyectos"
                            StartIcon="@Icons.Material.Filled.Work">
                            Ver proyectos
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" Href="/Portafolio//contacto"
                            StartIcon="@Icons.Material.Filled.Email">
                            Contactarme
                        </MudButton>
                    </MudStack>

                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Size="Size.Medium"
                            Href="https://github.com/Jorge2Echemendia" Target="_blank" />
                        <MudIconButton Icon="@Icons.Material.Filled.Email" Size="Size.Medium"
                            Href="mailto:jorge2echemendia@gmail.com" />
                    </MudStack>
                </MudStack>
            </MudItem>

            <MudItem xs="12" md="6" Class="d-flex justify-center">
                <div class="code-stage">
                    <div class="code-window">
                        <div class="window-header">
                            <span class="dot red"></span>
                            <span class="dot yellow"></span>
                            <span class="dot green"></span>
                            <span class="window-title">developer.cs</span>
                        </div>
                        <div class="window-body">
                            <code>
                                <span class="code-keyword">public class</span> <span class="code-type">Jorge</span><br/>
                                {<br/>
                                &nbsp;&nbsp;<span class="code-keyword">public string</span> Role { get; } = <span class="code-string">"Full-Stack Developer"</span>;<br/>
                                &nbsp;&nbsp;<span class="code-keyword">public string</span> University = <span class="code-string">"UCI"</span>;<br/>
                                &nbsp;&nbsp;<span class="code-keyword">public string</span>[] Skills =<br/>
                                &nbsp;&nbsp;{<br/>
                                &nbsp;&nbsp;&nbsp;&nbsp;<span class="code-string">".NET"</span>, <span class="code-string">"Node.js"</span>,<br/>
                                &nbsp;&nbsp;&nbsp;&nbsp;<span class="code-string">"Flutter"</span>, <span class="code-string">"Blazor"</span><br/>
                                &nbsp;&nbsp;};<br/>
                                &nbsp;&nbsp;<span class="code-keyword">public bool</span> IsAvailable => <span class="code-bool">true</span>;<br/>
                                }
                            </code>
                        </div>
                    </div>
                </div>
            </MudItem>
        </MudGrid>
    </MudContainer>
</section>

<section class="tech-section">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudText Typo="Typo.body2" Align="Align.Center" Class="section-kicker mb-4">
            Tecnologias
        </MudText>
        <div class="marquee">
            <div class="marquee-track">
                @foreach (var tech in _technologies.Concat(_technologies))
                {
                    <div class="tech-pill">
                        <div class="tech-logo-circle">
                            <img src="@tech.LogoUrl" alt="" class="tech-logo-img" />
                        </div>
                        <span class="tech-logo-name">@tech.Name</span>
                    </div>
                }
            </div>
        </div>
    </MudContainer>
</section>

<section class="stats-section">
    <MudContainer MaxWidth="MaxWidth.Large">
        <div class="bento-grid">
            <MudPaper Class="glass-card bento-card bento-feature pa-6" Elevation="0">
                <MudStack Spacing="2" Justify="Justify.SpaceBetween" Style="height:100%;">
                    <MudText Typo="Typo.caption" Class="bento-kicker">Enfoque</MudText>
                    <div>
                        <MudText Typo="Typo.h4" Class="page-title mb-3">De la API a la interfaz</MudText>
                        <MudText Typo="Typo.body1" Class="stat-copy">
                            Backend con .NET y Node.js, interfaces con Blazor y apps moviles con Flutter.
                            El mismo criterio de claridad en cada capa.
                        </MudText>
                    </div>
                </MudStack>
            </MudPaper>
            <MudPaper Class="stat-card bento-card pa-5" Elevation="0">
                <MudText Typo="Typo.h3" Color="Color.Primary" Class="stat-number">6+</MudText>
                <MudText Typo="Typo.body2" Class="mt-2" Style="color:var(--muted)">Tecnologias dominadas</MudText>
            </MudPaper>
            <MudPaper Class="stat-card bento-card pa-5" Elevation="0">
                <MudText Typo="Typo.h3" Color="Color.Primary" Class="stat-number">3</MudText>
                <MudText Typo="Typo.body2" Class="mt-2" Style="color:var(--muted)">Bases de datos</MudText>
            </MudPaper>
            <MudPaper Class="stat-card bento-card pa-5" Elevation="0">
                <MudText Typo="Typo.h3" Color="Color.Primary" Class="stat-number">10+</MudText>
                <MudText Typo="Typo.body2" Class="mt-2" Style="color:var(--muted)">Proyectos completados</MudText>
            </MudPaper>
            <MudPaper Class="stat-card bento-card pa-5" Elevation="0">
                <MudText Typo="Typo.h3" Color="Color.Primary" Class="stat-number">100%</MudText>
                <MudText Typo="Typo.body2" Class="mt-2" Style="color:var(--muted)">Compromiso</MudText>
            </MudPaper>
        </div>
    </MudContainer>
</section>

<section class="cta-section">
    <MudContainer MaxWidth="MaxWidth.Medium">
        <div class="glow-frame">
            <div class="cta-inner">
                <MudStack Spacing="3" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h4" Align="Align.Center" Class="page-title">
                        ¿Buscas un desarrollador comprometido?
                    </MudText>
                    <MudText Typo="Typo.body1" Align="Align.Center" Class="page-lead">
                        Estoy listo para contribuir a tu equipo y crecer profesionalmente.
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Href="/contacto"
                        StartIcon="@Icons.Material.Filled.Send">
                        Hablemos
                    </MudButton>
                </MudStack>
            </div>
        </div>
    </MudContainer>
</section>

