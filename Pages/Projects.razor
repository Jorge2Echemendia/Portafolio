@page "/proyectos"

<PageTitle Typo="Typo.h2">Proyectos | Jorge</PageTitle>

<section class="projects-section">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudText Typo="Typo.h4" Color="Color.Primary" Align="Align.Center">Mi trabajo</MudText>
        <MudText Typo="Typo.h3" Align="Align.Center" Class="mb-2">Proyectos</MudText>
        <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Class="mb-6">
            Una seleccion de proyectos que demuestran mis habilidades tecnicas
        </MudText>

        <MudGrid Spacing="4">
            @foreach (var project in _projects)
            {
                <MudItem xs="12" sm="6" lg="4">
                    <MudPaper Class="project-card" Elevation="0">
                        <div class="project-header" style="background: @project.Color;">
                            <MudIcon Icon="@project.Icon" Size="Size.Large" Style="color: white;" />
                        </div>
                        <MudCardContent Class="pa-5">
                            <MudText Typo="Typo.h6" Class="mb-2">@project.Title</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                                @project.Description
                            </MudText>
                            <div class="project-tags">
                                @foreach (var tag in project.Tags)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Color="@tag.Color" Class="project-tag">
                                        @tag.Name
                                    </MudChip>
                                }
                            </div>
                        </MudCardContent>
                        <MudCardActions Class="px-5 pb-4">
                            @if (!string.IsNullOrEmpty(project.GithubUrl))
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small"
                                           StartIcon="@Icons.Custom.Brands.GitHub"
                                           Href="@project.GithubUrl" Target="_blank">
                                    Codigo
                                </MudButton>
                            }
                            @* @if (!string.IsNullOrEmpty(project.DemoUrl))
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Launch"
                                           Href="@project.DemoUrl" Target="_blank">
                                    Demo
                                </MudButton>
                            } *@
                        </MudCardActions>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <MudPaper Class="more-projects-card pa-3 mt-4" Elevation="0">
            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Custom.Brands.GitHub" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.h6" Align="Align.Center">¿Quieres ver mas?</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    Visita mi perfil de GitHub para ver mas proyectos y contribuciones.
                </MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Custom.Brands.GitHub"
                           Href="https://github.com/Jorge2Echemendia" Target="_blank">
                    Ver GitHub
                </MudButton>
            </MudStack>
        </MudPaper>
    </MudContainer>
</section>

