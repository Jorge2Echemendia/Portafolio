@page "/sobre-mi"

<PageTitle>Sobre Mi | Jorge</PageTitle>

<section class="about-section">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudGrid Spacing="6" AlignItems="Center">
            <MudItem xs="12" md="5">
                <div class="about-image-wrapper">
                    <MudPaper Class="about-image-card pa-6" Elevation="0">
                        <div class="profile-photo-container">
                            <img src="images/profile.jpg" alt="Jorge - Ingeniero Informatico"
                                 class="profile-photo"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                            <div class="profile-photo-placeholder" style="display:none;">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large"
                                         Color="Color.Primary" Style="font-size: 100px;" />
                            </div>
                        </div>
                        <MudText Typo="Typo.h5" Align="Align.Center" Class="mt-3">Jorge</MudText>
                        <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                            Ingeniero Informatico Junior
                        </MudText>
                        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary"
                                 Size="Size.Small" Class="mt-2">
                            <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Small" Class="mr-1" />
                            UCI La Habana
                        </MudChip>
                    </MudPaper>
                </div>
            </MudItem>

            <MudItem xs="12" md="7">
                 <MudPaper Class="experience-card pa-5" Elevation="0">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h2" Color="Color.Primary">Conoceme</MudText>
                    <MudText Typo="Typo.h3">Sobre Mi</MudText>
                    <MudDivider Style="width: 60px;" />
                    <MudText Typo="Typo.body1" Class="about-text">
                        Soy Ingeniero Informatico, graduado de la <strong>Universidad de
                        Ciencias Informaticas (UCI)</strong> en La Habana, Cuba. Tengo una
                        gran pasion por el desarrollo de software y mi objetivo es crear
                        soluciones tecnologicas que resuelvan problemas reales y aporten
                        valor a los usuarios.
                    </MudText>
                    <MudText Typo="Typo.body1" Class="about-text">
                        Mi formación academica en la UCI me proporciono una base solida en
                        algoritmos, estructuras de datos, ingenieria de software y arquitectura
                        de sistemas, lo que me permite abordar problemas complejos con una
                        vision integral.
                    </MudText>
                    <MudText Typo="Typo.body1" Class="about-text">
                        Tengo experiencia trabajando con multiples tecnologias tanto en el
                        backend como en el frontend. He desarrollado aplicaciones web con
                        <strong>Node.js, Express.js, C# con Blazor y Entity Framework</strong>,
                        aplicaciones moviles con <strong>Flutter</strong>, y he trabajado con
                        bases de datos como <strong>Oracle, PostgreSQL y MongoDB</strong>.
                    </MudText>
                    <MudText Typo="Typo.body1" Class="about-text">
                        Me mantengo actualizado utilizando herramientas de IA como ChatGPT,
                        DeepSeek y Claude para mejorar mi productividad y aprendizaje continuo.
                        Utilizo Git y GitLab para control de versiones y Railway para despliegues.
                    </MudText>
                </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>
</section>

<section class="education-section">
    <MudContainer MaxWidth="MaxWidth.Medium">
        <MudPaper Class="education-card pa-6" Elevation="0">
            <MudGrid Spacing="4" AlignItems="Center">
                <MudItem xs="12" sm="3" Class="d-flex justify-center">
                    <MudAvatar Size="Size.Large" Color="Color.Primary" Style="width: 80px; height: 80px;">
                        <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Large" />
                    </MudAvatar>
                </MudItem>
                <MudItem xs="12" sm="9">
                    <MudText Typo="Typo.h6">Universidad de Ciencias Informaticas (UCI)</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Ingenieria en Ciencias Informaticas
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        La Habana, Cuba
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mt-2">
                        Formacion integral en desarrollo de software, bases de datos,
                        redes, inteligencia artificial y gestion de proyectos informaticos.
                    </MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudContainer>
</section>

<section class="experience-section">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-2">Experiencia Tecnica</MudText>
        <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Class="mb-6">
            Tecnologias y herramientas con las que he trabajado
        </MudText>

        <MudGrid Spacing="4">
            <MudItem xs="12" md="6">
                <MudPaper Class="experience-card pa-5" Elevation="0">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Code" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">Backend</MudText>
                    </MudStack>
                    <MudList T="string" Dense="true">
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">
                            <MudText Typo="Typo.body2"><strong>Node.js</strong> con Express.js para APIs REST</MudText>
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">
                            <MudText Typo="Typo.body2"><strong>C#</strong> con .NET y Entity Framework</MudText>
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">
                            <MudText Typo="Typo.body2"><strong>Blazor</strong> con MudBlazor para frontend web</MudText>
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">
                            <MudText Typo="Typo.body2"><strong>Flutter</strong> para aplicaciones moviles</MudText>
                        </MudListItem>
                    </MudList>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Class="experience-card pa-5" Elevation="0">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Secondary" />
                        <MudText Typo="Typo.h6">Bases de Datos y Herramientas</MudText>
                    </MudStack>
                    <MudList T="string" Dense="true">
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">
                            <MudText Typo="Typo.body2"><strong>PostgreSQL</strong> - Base de datos relacional</MudText>
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">
                            <MudText Typo="Typo.body2"><strong>Oracle</strong> - Base de datos empresarial</MudText>
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">
                            <MudText Typo="Typo.body2"><strong>MongoDB</strong> - Base de datos NoSQL</MudText>
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">
                            <MudText Typo="Typo.body2"><strong>Git/GitLab</strong> - Control de versiones</MudText>
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">
                            <MudText Typo="Typo.body2"><strong>Railway</strong> - Despliegue de aplicaciones</MudText>
                        </MudListItem>
                    </MudList>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>
</section>

<section class="tools-section">
    <MudContainer MaxWidth="MaxWidth.Medium">
        <MudPaper Class="tools-card pa-6" Elevation="0">
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">IDEs y Herramientas</MudText>
            <MudGrid Spacing="3" Justify="Justify.Center">
                @foreach (var tool in _tools)
                {
                    <MudItem xs="6" sm="4" md="3">
                        <div class="tool-item">
                            <MudIcon Icon="@tool.Icon" Color="Color.Primary" />
                            <MudText Typo="Typo.body2" Align="Align.Center">@tool.Name</MudText>
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>
    </MudContainer>
</section>

@code {
    private List<(string Name, string Icon)> _tools = new()
    {
        ("Visual Studio", Icons.Material.Filled.DeveloperBoard),
        ("VS Code", Icons.Material.Filled.Code),
        ("Android Studio", Icons.Material.Filled.Android),
        ("Git/GitLab", Icons.Material.Filled.AccountTree),
        ("ChatGPT", Icons.Material.Filled.SmartToy),
        ("DeepSeek", Icons.Material.Filled.Psychology),
        ("Claude", Icons.Material.Filled.AutoAwesome),
        ("Railway", Icons.Material.Filled.Train)
    };
}
