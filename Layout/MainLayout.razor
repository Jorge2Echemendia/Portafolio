@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" IsDarkMode="@_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="@AppClass">
    <MudAppBar Elevation="0" Fixed="true" Class="portfolio-navbar">
        <MudContainer MaxWidth="MaxWidth.Large" Class="d-flex align-center justify-space-between">
            <MudLink Href="https://jorge2echemendia.github.io/Portafolio/" Underline="Underline.None" Class="portfolio-logo">
                <span class="logo-bracket">&lt;</span>Jorge<span class="logo-bracket">/&gt;</span>
            </MudLink>

            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <div class="nav-links">
                    <MudButton Href="https://jorge2echemendia.github.io/Portafolio/" Color="Color.Inherit" Class="nav-link">Inicio</MudButton>
                    <MudButton Href="/Portafolio/sobre-mi" Color="Color.Inherit" Class="nav-link">Sobre Mi</MudButton>
                    <MudButton Href="/Portafolio/habilidades" Color="Color.Inherit" Class="nav-link">Habilidades</MudButton>
                    <MudButton Href="/Portafolio/proyectos" Color="Color.Inherit" Class="nav-link">Proyectos</MudButton>
                    <MudButton Href="/Portafolio/contacto" Variant="Variant.Filled" Color="Color.Primary" Class="nav-contact-btn">Contacto</MudButton>
                    <MudToggleIconButton @bind-Toggled="@_isDarkMode"
                                         Icon="@Icons.Material.Filled.DarkMode"
                                         ToggledIcon="@Icons.Material.Filled.LightMode"
                                         Color="Color.Inherit"
                                         ToggledColor="Color.Warning"
                                         Class="theme-toggle" />
                </div>
            </MudHidden>

            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <div class="d-flex align-center">
                    <MudToggleIconButton @bind-Toggled="@_isDarkMode"
                                         Icon="@Icons.Material.Filled.DarkMode"
                                         ToggledIcon="@Icons.Material.Filled.LightMode"
                                         Color="Color.Inherit"
                                         ToggledColor="Color.Warning" />
                    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                                   OnClick="@ToggleDrawer" />
                </div>
            </MudHidden>
        </MudContainer>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.Right" Elevation="0" Variant="DrawerVariant.Temporary" Class="mobile-drawer">
        <div class="drawer-head">
            <MudText Typo="Typo.h6" Class="portfolio-logo">
                <span class="logo-bracket">&lt;</span>Jorge<span class="logo-bracket">/&gt;</span>
            </MudText>
        </div>
        <MudNavMenu Class="drawer-nav">
            <MudNavLink Href="/https://jorge2echemendia.github.io/Portafolio/" OnClick="@CloseDrawer">Inicio</MudNavLink>
            <MudNavLink Href="/Portafolio/sobre-mi" OnClick="@CloseDrawer">Sobre Mi</MudNavLink>
            <MudNavLink Href="/Portafolio/habilidades" OnClick="@CloseDrawer">Habilidades</MudNavLink>
            <MudNavLink Href="/Portafolio/proyectos" OnClick="@CloseDrawer">Proyectos</MudNavLink>
            <MudNavLink Href="/Portafolio/contacto" OnClick="@CloseDrawer">Contacto</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <main class="portfolio-main">
        @Body
    </main>

    <footer class="portfolio-footer">
        <MudContainer MaxWidth="MaxWidth.Large">
            <div class="footer-content">
                <MudText Typo="Typo.body2" Class="footer-text">
                    &copy; @DateTime.Now.Year Jorge. Construido con Blazor y MudBlazor.
                </MudText>
                <div class="footer-links">
                    <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Size="Size.Small"
                                   Href="https://github.com/Jorge2Echemendia" Target="_blank" />
                    <MudIconButton Icon="@Icons.Material.Filled.Email" Size="Size.Small"
                                   Href="mailto:jorge2echemendia@gmail.com" />
                </div>
            </div>
        </MudContainer>
    </footer>
</div>

@code {
    private bool _drawerOpen;
    private bool _isDarkMode = true;

    private string AppClass => _isDarkMode ? "portfolio-app is-dark" : "portfolio-app";

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2563EB",
            Secondary = "#6366F1",
            Background = "#F4F7FB",
            Surface = "#FFFFFF",
            AppbarBackground = "rgba(244,247,251,0.72)",
            AppbarText = "#0F172A",
            TextPrimary = "#0F172A",
            TextSecondary = "#64748B",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#0F172A",
            Success = "#10B981",
            Error = "#EF4444",
            Warning = "#F59E0B",
            Info = "#3B82F6",
            ActionDefault = "#64748B",
            Divider = "rgba(15,23,42,0.08)",
            LinesDefault = "rgba(15,23,42,0.08)"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#3B82F6",
            Secondary = "#818CF8",
            Background = "#07080D",
            Surface = "#101218",
            BackgroundGray = "#0B0C12",
            AppbarText = "#F4F4F5",
            AppbarBackground = "rgba(7,8,13,0.72)",
            DrawerBackground = "#0C0E14",
            ActionDefault = "#A1A1AA",
            ActionDisabled = "#9999994d",
            ActionDisabledBackground = "#605f6d4d",
            TextPrimary = "#F4F4F5",
            TextSecondary = "#A1A1AA",
            TextDisabled = "#ffffff33",
            DrawerIcon = "#A1A1AA",
            DrawerText = "#E4E4E7",
            GrayLight = "#181A22",
            GrayLighter = "#101218",
            Info = "#60A5FA",
            Success = "#34D399",
            Warning = "#FBBF24",
            Error = "#FB7185",
            LinesDefault = "rgba(255,255,255,0.08)",
            TableLines = "rgba(255,255,255,0.08)",
            Divider = "rgba(255,255,255,0.08)",
            OverlayLight = "rgba(0,0,0,0.6)"
        }
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void CloseDrawer() => _drawerOpen = false;
}
